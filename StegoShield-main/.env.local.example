# Copy this file to .env.local and fill in your real values.
# server.js loads .env.local automatically — no extra setup needed.

# Your MongoDB connection string (see README.md "Database setup" for how to get one for free)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority

# Optional — database name to use (defaults to "stegosecure" if omitted)
MONGODB_DB=stegosecure

# Optional — port for the local server (defaults to 3000)
PORT=3000

# Admin login — checked server-side now (see api/auth.js). Change these before
# you show this to anyone else; if left unset it falls back to admin/admin123.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
